# ============================================================================
# SUPABASE EDGE FUNCTIONS ENVIRONMENT VARIABLES EXAMPLE
# Copy to supabase/.env for local development or set in Supabase Dashboard
# NEVER commit real production secret values to version control.
# ============================================================================

# Meta Graph API Version (Defaults to v26.0)
META_GRAPH_API_VERSION=v26.0

# Meta App Credentials (Required for Webhook Signature Verification)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Meta WhatsApp Webhook Verification Secret Token (Shared between Meta & Noverlyn)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=noverlyn_webhook_secret_verify_token_change_me

# Supabase Project Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
